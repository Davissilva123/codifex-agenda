{
  "name": "minha-agenda",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop:dev": "node scripts/build-desktop.mjs && node scripts/prepare-desktop.mjs && electron .",
    "desktop:package": "node scripts/build-desktop.mjs && node scripts/prepare-desktop.mjs && electron-builder --win dir"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "br.com.minhaagenda.desktop",
    "productName": "Minha Agenda",
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "desktop/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "web",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
